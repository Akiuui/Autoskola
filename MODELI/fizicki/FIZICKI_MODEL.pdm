<o:BusinessRule Id="o100">
<a:ObjectID>575E4F8B-3A9F-4F95-95A0-840493FBCEBD</a:ObjectID>
<a:Name>CK_Cas_Tip_Polja</a:Name>
<a:Code>CK_Cas_Tip_Polja</a:Code>
<a:CreationDate>1784192505</a:CreationDate>
<a:Creator>aleksa.stojanovic</a:Creator>
<a:ModificationDate>1784192505</a:ModificationDate>
<a:Modifier>aleksa.stojanovic</a:Modifier>
<a:Type>5</a:Type>
<a:ServerExpression>(
            Obuka_id IS NOT NULL
            AND Vozilo_id IS NOT NULL
            AND Grupa_id IS NULL
        )
        OR
        (
            Grupa_id IS NOT NULL
            AND Obuka_id IS NULL
            AND Vozilo_id IS NULL
        )</a:ServerExpression>
</o:BusinessRule>
<o:BusinessRule Id="o101">
<a:ObjectID>43927DB6-7171-4231-9BDF-6B14F940B78D</a:ObjectID>
<a:Name>CK_Polaganje_kandidat_Uspesno_Poeni</a:Name>
