<a:ModificationDate>1784192505</a:ModificationDate>
<a:Modifier>aleksa.stojanovic</a:Modifier>
<a:Type>5</a:Type>
<a:ServerExpression>Email IS NULL OR Email LIKE &#39;%@%.%&#39;</a:ServerExpression>
</o:BusinessRule>
<o:BusinessRule Id="o86">
<a:ObjectID>641F961E-2775-4C34-99F0-CA613FCA904B</a:ObjectID>
