<c:BusinessRules>
<o:BusinessRule Id="o83">
<a:ObjectID>185ABFA7-57EC-4E8C-BF05-9E1F2C638E1C</a:ObjectID>
<a:Name>CK_Kandidat_Ime_Prezime_Format</a:Name>
<a:Code>CK_Kandidat_Ime_Prezime_Format</a:Code>
<a:CreationDate>1784192505</a:CreationDate>
<a:Creator>aleksa.stojanovic</a:Creator>
<a:ModificationDate>1784192505</a:ModificationDate>
<a:Modifier>aleksa.stojanovic</a:Modifier>
<a:Type>5</a:Type>
<a:ServerExpression>Ime NOT LIKE N&#39;%[^A-Za-zÄ‡ÄÅ¡Ä‘Å¾Ä†ÄŒÅ ÄÅ½]%&#39;
        AND Ime LIKE N&#39;[A-ZÄ†ÄŒÅ ÄÅ½]%&#39;
        AND Ime NOT LIKE N&#39;% %&#39;
        AND Prezime NOT LIKE N&#39;%[^A-Za-zÄ‡ÄÅ¡Ä‘Å¾Ä†ÄŒÅ ÄÅ½]%&#39;
        AND Prezime LIKE N&#39;[A-ZÄ†ÄŒÅ ÄÅ½]%&#39;
        AND Prezime NOT LIKE N&#39;% %&#39;</a:ServerExpression>
</o:BusinessRule>
<o:BusinessRule Id="o84">
<a:ObjectID>13D9E687-501E-47A1-96A0-DE5AC40C9FB7</a:ObjectID>
<a:Name>CK_Kandidat_Tekst_Optional</a:Name>
<a:Code>CK_Kandidat_Tekst_Optional</a:Code>
<a:CreationDate>1784192505</a:CreationDate>
<a:Creator>aleksa.stojanovic</a:Creator>
<a:ModificationDate>1784192505</a:ModificationDate>
<a:Modifier>aleksa.stojanovic</a:Modifier>
<a:Type>5</a:Type>
<a:ServerExpression>(Ime_roditelja IS NULL OR LEN(LTRIM(RTRIM(Ime_roditelja))) &gt; 0)
        AND (Email IS NULL OR LEN(LTRIM(RTRIM(Email))) &gt; 0)</a:ServerExpression>
</o:BusinessRule>
<o:BusinessRule Id="o85">
<a:ObjectID>9E374825-3BAD-4B68-AEF0-A4A9E80ED793</a:ObjectID>
<a:Name>CK_Kandidat_Email_Format</a:Name>
