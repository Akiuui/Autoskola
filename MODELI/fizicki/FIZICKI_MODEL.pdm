<a:ServerExpression>Status IN (N&#39;Zakazan&#39;, N&#39;Odrzan&#39;, N&#39;Otkazan&#39;)</a:ServerExpression>
</o:BusinessRule>
<o:BusinessRule Id="o99">
<a:ObjectID>05D15062-2B07-451F-8F19-6910FE501E43</a:ObjectID>
