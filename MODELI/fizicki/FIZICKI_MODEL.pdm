<a:ModificationDate>1784192505</a:ModificationDate>
<a:Modifier>aleksa.stojanovic</a:Modifier>
<a:Type>5</a:Type>
<a:ServerExpression>(Uspesno IS NULL AND Broj_Poenta IS NULL)
        OR
        (Uspesno IS NOT NULL AND Broj_Poenta IS NOT NULL)</a:ServerExpression>
</o:BusinessRule>
